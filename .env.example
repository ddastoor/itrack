# ==============================================================================
# iTrack (v2.0.0) — Sanitized Environment Variable Template (.env.example)
# ==============================================================================
#
# IMPORTANT USAGE & CLEAN-ROOT NOTES (READ FIRST):
#
# 1. ZERO EXTERNAL SECRETS:
#    iTrack is 100% local-first, offline-capable, and self-contained. It requires
#    NO cloud API keys, LLM tokens, database passwords, OAuth secrets, or webhooks.
#
# 2. NO AUTOMATIC `.env` LOADER (`python-dotenv` IS NOT USED):
#    `itrack.py` and `itrack-server.py` read exported process environment variables
#    directly via `os.environ`. Every variable below is optional.
#
# 3. DO NOT CREATE AN UNTRACKED `.env` FILE INSIDE THE `itrack` REPOSITORY ROOT!
#    Law 1 (`assert_clean_repo_root` in `tests/helpers.py`) enforces an exact
#    8-entry root allowlist (`itrack.py`, `itrack-server.py`,
#    `itrack-requirements.txt`, `tests`, `SPEC.md`, `todo.md`, `AGENTS.md`,
#    `.env.example`). Placing an untracked `.env` file inside the `itrack` repo
#    root will cause `tests/run_all.py` and `test_01` to fail!
#
#    Recommended local usage (store outside the repo and source in your shell):
#      mkdir -p ~/.config/itrack
#      cp .env.example ~/.config/itrack/env
#      set -a && source ~/.config/itrack/env && set +a
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Workspace & Actor Identity Overrides (Optional)
# ------------------------------------------------------------------------------

# Default target Git repository root when `--root <path>` is omitted on the CLI
# or daemon command line.
# Read in: `itrack.py` (`resolve_and_check_git_root`), `itrack-server.py` (`resolve_raw_root_arg`)
# Fallback when unset: Current working directory (`Path.cwd()`).
# Must point to a valid Git repository root containing `.git` (Law 2, else exit 2).
# ITRACK_ROOT=/absolute/path/to/your/target-git-repo

# Primary actor identity used as default `reporter`, comment/worklog `author`,
# audit-history `actor`, and resolution target for the `@me` iQL macro.
# Read in: `itrack.py` (`default_actor`), `itrack-server.py` (`detect_default_user`)
# Fallback chain when unset:
#   - `itrack.py`:        ITRACK_USER -> ITRACK_AGENT -> `git config user.name` -> getpass.getuser() -> "user"
#   - `itrack-server.py`: ITRACK_USER -> `git config user.name` -> USER -> "user"
# ITRACK_USER="Jane Developer"

# Secondary CLI actor identity override read by `itrack.py` when `ITRACK_USER`
# is unset. Useful for tagging automated CLI mutations from an AI coding agent
# without overriding human `ITRACK_USER` or `git config user.name`.
# Read in: `itrack.py` (`default_actor`)
# ITRACK_AGENT="antigravity-local-agent"

# ------------------------------------------------------------------------------
# 2. Daemon Script & Surface-Telemetry Overrides (Advanced / Test Harness)
# ------------------------------------------------------------------------------

# Explicit filesystem path to `itrack-server.py` used by `itrack.py` when
# auto-spawning a per-workspace loopback daemon.
# Read in: `itrack.py` (`locate_server_script`)
# Fallback when unset: `<directory_of_itrack.py>/itrack-server.py`
# ITRACK_SERVER_SCRIPT=/absolute/path/to/itrack/itrack-server.py

# Path to a flock-synchronized JSONL file where `itrack.py` and `itrack-server.py`
# append `cli_exec`, `api_hit`, and `ui_telemetry` events for 100% surface auditing.
# Read in: `itrack.py` (`record_cli_surface`), `itrack-server.py` (`record_surface_event`),
#          `tests/helpers.py` (`compute_surface_audit`), `tests/run_all.py`
# Leave unset during normal usage; `tests/run_all.py` sets this automatically
# inside `/tmp/itrack_coverage*/surface_events.jsonl`.
# ITRACK_SURFACE_LOG=/tmp/itrack_surface_events.jsonl

# ------------------------------------------------------------------------------
# 3. Python Bytecode Guardrail (Strongly Recommended for iTrack Development)
# ------------------------------------------------------------------------------

# Suppresses creation of `__pycache__/` directories and `.pyc` files.
# Required when running Python commands inside the `itrack` source repository so
# `tests/` remains free of forbidden bytecode artifacts (`FORBIDDEN_ARTIFACT_NAMES`).
PYTHONDONTWRITEBYTECODE=1

# ------------------------------------------------------------------------------
# 4. Terminal Rendering & Browser Launcher Preferences (Optional Standard Vars)
# ------------------------------------------------------------------------------

# Disable ANSI colors and styles in Rich human-readable CLI output when set to `1`.
# Respected by: `rich` console rendering in `itrack.py`
# NO_COLOR=1

# Override detected terminal width / capability for Rich tables and panels.
# Respected by: `rich` console rendering in `itrack.py`
# COLUMNS=140
# TERM=xterm-256color

# Preferred browser executable used by Python's `webbrowser.open()` when running
# `python3 -B itrack.py ui` (ignored when `--no-browser` is passed).
# Respected by: `itrack.py` (`cmd_ui`)
# BROWSER=google-chrome

# Note on HTTP Proxies:
# `HTTP_PROXY`, `HTTPS_PROXY`, and `ALL_PROXY` are intentionally IGNORED by all
# `itrack.py` HTTP clients (`httpx.Client(..., trust_env=False)`) so corporate or
# cloud proxy variables never intercept `127.0.0.1` loopback daemon traffic.
